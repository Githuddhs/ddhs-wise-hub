# Self-hosted server configuration
DATABASE_URL="postgres://ddhs:ddhs_dev_password@127.0.0.1:5432/ddhs"

# Secret used to sign sessions/storage URLs — set a long random value in production:
#   openssl rand -hex 32
APP_SECRET="dev-only-change-me-in-production"

# Where uploaded evidence files are stored on disk
UPLOADS_DIR="./uploads"

# Public address of the deployed app (used for PayFast callbacks)
PUBLIC_BASE_URL="http://localhost:8080"

# Transactional email — DDHS mail server (SSL/TLS)
SMTP_HOST="mail.ddhs.co.za"
SMTP_PORT="465"
SMTP_USER="sdm@ddhs.co.za"
SMTP_PASS=""   # the sdm@ddhs.co.za mailbox password
SMTP_FROM="DDHS Equity Intelligence <sdm@ddhs.co.za>"

# AI tools (direct OpenAI API)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
